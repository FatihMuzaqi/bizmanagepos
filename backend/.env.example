# ==============================================================================
# BIZMANAGE MULTI-TENANT SAAS POS - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure with secure production secrets.
# NEVER commit the actual .env file to version control.

# --- Application Environment ---
NODE_ENV=production
PORT=5000

# --- Database Configuration (MySQL) ---
# Supported prefixes: DATABASE_* or DB_*
DATABASE_HOST=db.yourdomain.com
DATABASE_PORT=3306
DATABASE_NAME=bizmanage_db
DATABASE_USER=bizmanage_admin
DATABASE_PASSWORD=YourStrongDatabasePasswordHere123!
DATABASE_DIALECT=mysql
DATABASE_LOGGING=false
DATABASE_POOL_MAX=25
DATABASE_POOL_MIN=5
DATABASE_POOL_ACQUIRE=60000
DATABASE_POOL_IDLE=10000

# --- Authentication & JWT Security ---
# Generate high-entropy 256-bit+ random secrets (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=your_super_secret_high_entropy_jwt_access_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_high_entropy_jwt_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of approved production frontend domains (HTTPS only)
CORS_ORIGIN=https://app.yourdomain.com,https://pos.yourdomain.com,https://admin.yourdomain.com

# --- Rate Limiting & Protection ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# --- Database Backup & Retention ---
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=./backups
